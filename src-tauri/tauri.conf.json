{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVE",
  "version": "1.0.0",
  "identifier": "com.eve.local",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EVE",
        "width": 1100,
        "height": 900,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "Runs entirely on your device. No account, no key, nothing uploaded.",
    "category": "Utility",
    "shortDescription": "A neural network built from scratch",
    "longDescription": "EVE grades trading cards and learns to recognise the objects you show her, using a neural network written from scratch \u2014 no libraries, no pretrained weights, no cloud. Everything runs on this machine: the camera never leaves the app, and there is no account or API key anywhere.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  }
}
